# Copy to .env next to compose.yaml and fill in. Never commit .env.
# External Minecraft server the companion joins.
MC_HOST=mc.example.org
MC_PORT=25565
MC_VERSION=1.21.1
# Bot account name. With MF_AUTH=microsoft, the Microsoft account's email or profile name.
MC_USERNAME=arena_companion
# offline (server has online-mode=false) or microsoft (premium server).
MF_AUTH=offline
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMPANION_BRIDGE_TOKEN=
# OpenAI-compatible base URL serving the model in model.json: an official API,
# or a service on this host (http://host.docker.internal:PORT/v1).
MODEL_UPSTREAM_URL=https://api.deepseek.com
# Optional key; only the model relay receives it. Leave empty when the upstream needs none.
MODEL_UPSTREAM_KEY=
# Optional spending limit per participant, USD per hour at list price; empty = none.
# Enforced inside each participant's Pi session; needs cost in the model descriptor.
MODEL_COST_PER_HOUR=
# Optional.
# COMPANION_SESSION_ID=companion
# COMPANION_PROMPT_PATH=./PROMPT.md
# ARENA_CHAT_WAKE=mention
