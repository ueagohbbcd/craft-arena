FROM node:24-bookworm-slim
# Bootstrap HTTPS with Node's bundled CA roots; Debian then installs its managed CA bundle.
RUN node -e "const fs=require('node:fs');fs.mkdirSync('/etc/ssl/certs',{recursive:true});fs.writeFileSync('/etc/ssl/certs/ca-certificates.crt',require('node:tls').rootCertificates.join('\n'))" \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates git python3 chromium ripgrep fd-find && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/arena
COPY scripts/mf-reference.json scripts/prepare-mf-reference.mjs ./scripts/
RUN node scripts/prepare-mf-reference.mjs /opt/mf-reference && chown -R node:node /opt/mf-reference
ENV ARENA_REFERENCE_ROOT="/opt/mf-reference"
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --ignore-scripts && chown -R node:node /opt/arena
# Only participant-side code and its documentation enter this image: no
# trusted-side source (arena host, bridge, budget gateway, proxy relay), no
# tests, no developer docs, no operator configuration. The list is checked by
# tests/deployment.test.mjs.
COPY --chown=node:node packages/pi-extension ./packages/pi-extension
COPY --chown=node:node packages/tasks ./packages/tasks
COPY --chown=node:node packages/inbox ./packages/inbox
COPY --chown=node:node packages/bot-sdk ./packages/bot-sdk
COPY --chown=node:node packages/observation ./packages/observation
COPY --chown=node:node packages/default-scripts ./packages/default-scripts
COPY --chown=node:node packages/world-visual ./packages/world-visual
COPY --chown=node:node examples ./examples
COPY --chown=node:node docs/CONTEXT-DELIVERY.md ./docs/CONTEXT-DELIVERY.md
COPY --chown=node:node scripts/archive-participant-state.mjs ./scripts/archive-participant-state.mjs
RUN mkdir -p /workspace /team-git && chown node:node /workspace /team-git
ENV CHROMIUM_PATH="/usr/bin/chromium"
ENV PATH="/opt/arena/node_modules/.bin:${PATH}"
USER node
WORKDIR /workspace
# Arbitrary agent/script commands can override CMD; plugins share the same participant sandbox.
CMD ["node", "/opt/arena/packages/pi-extension/bootstrap.mjs"]

