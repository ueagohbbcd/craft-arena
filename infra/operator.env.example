# Copy to a private .env file outside the source archive and replace each placeholder.
# Prepare runtime/server with scripts/prepare-minecraft-server.mjs, then build Minecraft.
# Configure the selected map, private RCON and EULA in the trusted world volume.
MC_SERVER_IMAGE=craft-arena-minecraft:local
MC_SERVER_BUILD_CONTEXT=../runtime/server
# The protocol version the bridges speak; must match the server.
MC_VERSION=1.21.1
# Mode instructions the bridges hand to the models (relative to infra/).
ARENA_PROMPT_FILE=./maps/race-of-wool/agents.d/20-race-of-wool.md
# Match file for the arena tool service (copy match.live.template.json).
ARENA_MATCH_FILE=./match.live.json
# Same server memory budget as the Windows template, leaving room above the 2 GiB heap.
MC_MEMORY_LIMIT=3g
# Bridges and packages/arena/src/cli.mjs reach the server's RCON with it.
MC_RCON_PASSWORD=REPLACE_WITH_OPERATOR_RCON_PASSWORD

# The model relay forwards participants' model calls to this OpenAI-compatible
# base URL: an official API, or a service on the host such as
# http://host.docker.internal:8317/v1. model.example.json names the model served there.
MODEL_UPSTREAM_URL=https://api.openai.com/v1
# Optional; only the model relay receives it. Leave empty when the upstream needs none.
MODEL_UPSTREAM_KEY=REPLACE_WITH_UPSTREAM_KEY_OR_LEAVE_EMPTY
# Optional spending limit per participant, USD per hour at list price; empty = none.
# Enforced inside each participant's Pi session; needs cost in the model descriptor.
MODEL_COST_PER_HOUR=

# Separate participant-scoped identities. Keep opposing teams' values distinct.
RED1_BRIDGE_TOKEN=REPLACE_WITH_RED1_SCOPED_BRIDGE_TOKEN
BLUE1_BRIDGE_TOKEN=REPLACE_WITH_BLUE1_SCOPED_BRIDGE_TOKEN

ARENA_CPU_LIMIT=2.0
ARENA_MEMORY_LIMIT=2g
ARENA_PIDS_LIMIT=256

