# Copy to a private .env file outside the source archive and replace each placeholder.
# Prepare runtime/server with scripts/prepare-minecraft-server.mjs, then build Minecraft.
# Configure the selected map, private RCON and EULA in the trusted world volume.
MC_SERVER_IMAGE=craft-arena-minecraft:local
MC_SERVER_BUILD_CONTEXT=../runtime/server
# Standalone compose.yaml only; live protocol version is in the match JSON.
MC_VERSION=1.21.1
# Keep longer than live.replay.saveTimeoutMs plus command/bot cleanup.
ARENA_HOST_STOP_GRACE_PERIOD=180s
# Same server memory budget as the Windows template, leaving room above the 2 GiB heap.
MC_MEMORY_LIMIT=3g
MC_RCON_PASSWORD=REPLACE_WITH_OPERATOR_RCON_PASSWORD

# Edit model.example.json once for the gateway and Pi public model descriptor.
MODEL_UPSTREAM_KEY=REPLACE_WITH_UPSTREAM_KEY_TRUSTED_GATEWAY_ONLY

# Separate participant-scoped identities. Keep opposing teams' values distinct.
RED1_MODEL_TOKEN=REPLACE_WITH_RED1_SCOPED_MODEL_TOKEN
BLUE1_MODEL_TOKEN=REPLACE_WITH_BLUE1_SCOPED_MODEL_TOKEN
RED1_BRIDGE_TOKEN=REPLACE_WITH_RED1_SCOPED_BRIDGE_TOKEN
BLUE1_BRIDGE_TOKEN=REPLACE_WITH_BLUE1_SCOPED_BRIDGE_TOKEN
# Read-only session tokens for the budget gateway (must differ from the bridge tokens).
RED1_STATUS_TOKEN=REPLACE_WITH_RED1_STATUS_TOKEN
BLUE1_STATUS_TOKEN=REPLACE_WITH_BLUE1_STATUS_TOKEN
# Bridges read their session from the arena host with this token (backend network only).
ARENA_HOST_TOKEN=REPLACE_WITH_ARENA_HOST_SESSION_TOKEN

ARENA_CPU_LIMIT=2.0
ARENA_MEMORY_LIMIT=2g
ARENA_PIDS_LIMIT=256

