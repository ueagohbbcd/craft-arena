# Copy to a private .env file outside the source archive and replace each placeholder.
# The operator supplies a server image with the selected map, RCON and applicable agreements configured.
MC_SERVER_IMAGE=REPLACE_WITH_REVIEWED_SERVER_IMAGE
MC_VERSION=REPLACE_WITH_EXACT_MINECRAFT_VERSION
MC_RCON_PASSWORD=REPLACE_WITH_OPERATOR_RCON_PASSWORD

# Model ID must match the gateway model allowlist and Pi profile.
ARENA_MODEL_ID=REPLACE_WITH_ALLOWED_MODEL_ID
MODEL_UPSTREAM_KEY=REPLACE_WITH_UPSTREAM_KEY_TRUSTED_GATEWAY_ONLY

# Separate participant-scoped identities. Keep opposing teams' values distinct.
RED1_MODEL_TOKEN=REPLACE_WITH_RED1_SCOPED_MODEL_TOKEN
BLUE1_MODEL_TOKEN=REPLACE_WITH_BLUE1_SCOPED_MODEL_TOKEN
RED1_BRIDGE_TOKEN=REPLACE_WITH_RED1_SCOPED_BRIDGE_TOKEN
BLUE1_BRIDGE_TOKEN=REPLACE_WITH_BLUE1_SCOPED_BRIDGE_TOKEN

ARENA_CPU_LIMIT=2.0
ARENA_MEMORY_LIMIT=2g
ARENA_PIDS_LIMIT=256
