{
  "name": "craft-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft coding-agent race arena with a semantic bot bridge and Pi inbox integration",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:core": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "validate": "npm run check && npm test",
    "demo:match": "node packages/arena/src/cli.mjs simulate infra/match.example.json",
    "demo:visual": "node examples/render-fixture.mjs",
    "format": "prettier --write \"packages/**/*.mjs\" \"tests/**/*.mjs\" \"examples/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"packages/**/*.mjs\" \"tests/**/*.mjs\" \"examples/**/*.mjs\" \"scripts/**/*.mjs\"",
    "arena:live": "node packages/arena/src/live-cli.mjs",
    "agent:start": "node packages/pi-extension/bootstrap.mjs",
    "auth:codex": "node packages/codex-adapter/login.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2",
    "prismarine-block": "1.23.0",
    "prismarine-item": "1.18.0",
    "prismarine-physics": "1.11.1",
    "prismarine-registry": "1.12.0",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "vec3": "0.2.0"
  },
  "optionalDependencies": {
    "playwright": "1.64.0",
    "prismarine-viewer": "1.33.0"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
