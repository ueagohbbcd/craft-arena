{
  "name": "craft-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft coding-agent race arena with a semantic bot bridge and Pi inbox integration",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "verify:server": "node scripts/verify-server-protocol.mjs",
    "validate": "npm run check && npm test",
    "demo:screenshot": "node examples/render-fixture.mjs",
    "format": "prettier --write \"packages/**/*.mjs\" \"tests/**/*.mjs\" \"examples/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"packages/**/*.mjs\" \"tests/**/*.mjs\" \"examples/**/*.mjs\" \"scripts/**/*.mjs\"",
    "arena": "node packages/arena/src/cli.mjs",
    "agent:start": "node packages/pi-extension/bootstrap.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2",
    "mineflayer-world-memory": "https://codeload.github.com/ueagohbbcd/mineflayer-world-memory/tar.gz/a65adaa1b4695df33b4d708b9811d6a4c51ad783",
    "prismarine-block": "1.23.0",
    "prismarine-chunk": "1.41.0",
    "prismarine-item": "1.18.0",
    "prismarine-physics": "1.11.1",
    "prismarine-registry": "1.12.0",
    "prismarine-windows": "2.10.0",
    "vec3": "0.2.0"
  },
  "optionalDependencies": {
    "playwright": "1.64.0",
    "prismarine-viewer": "1.33.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "prettier": "3.9.9",
    "yaml": "2.9.0"
  }
}
